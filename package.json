{
  "name": "pi-notes",
  "version": "0.2.0",
  "description": "Session-local durable execution checkpoints for Pi",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evanqhuang/pi-notes.git"
  },
  "homepage": "https://github.com/evanqhuang/pi-notes#readme",
  "bugs": {
    "url": "https://github.com/evanqhuang/pi-notes/issues"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "notes",
    "task-state",
    "checkpoint"
  ],
  "files": [
    "entry.ts",
    "index.ts",
    "README.md",
    "BENCHMARK.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./entry.ts"]
  },
  "scripts": {
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "25.5.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
